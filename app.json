{
  "expo": {
    "name": "IdeaPocket",
    "slug": "ideapocket",
    "version": "0.5.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./src/assets/icons/app-icon.png",
    "splash": {
      "image": "./src/assets/icons/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F8FC",
      "dark": {
        "image": "./src/assets/icons/app-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#0D1117"
      }
    },
    "backgroundColor": "#F7F8FC",
    "extra": {
      "eas": {
        "projectId": "fc886f40-7011-43dc-b353-541d4cec9957"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fc886f40-7011-43dc-b353-541d4cec9957",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "androidNavigationBar": {
      "backgroundColor": "#F7F8FC",
      "barStyle": "dark-content"
    },
    "owner": "lenny889",
    "android": {
      "icon": "./src/assets/icons/app-icon-android.png",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icons/app-icon-adaptive-foreground.png",
        "backgroundColor": "#2F6FED"
      },
      "package": "com.ideapocket.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-splash-screen",
      [
        "expo-audio",
        {
          "microphonePermission": "允许 IdeaPocket 使用麦克风，把你说的话转写成文字记录。"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 IdeaPocket 访问相册，把图片附加到笔记。",
          "cameraPermission": "允许 IdeaPocket 使用相机，为笔记拍摄图片。"
        }
      ],
      "expo-secure-store",
      "expo-font"
    ]
  }
}
